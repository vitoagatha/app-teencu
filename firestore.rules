rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'username', 'points', 'lastMbti', 'lastMbtiDate', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'username', 'points', 'lastMbti', 'lastMbtiDate', 'createdAt'
        ])
        && request.resource.data.username == 'user-' + uid
        && request.resource.data.points is int
        && request.resource.data.points == 0
        && request.resource.data.lastMbti == ''
        && request.resource.data.lastMbtiDate == null
        && request.resource.data.createdAt == request.time;

      // Compatibility with the existing personal MBTI test, without XP.
      // These client-computed results are not authoritative reward evidence.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMbti', 'lastMbtiDate'])
        && request.resource.data.lastMbti in [
          'ISTJ', 'ISFJ', 'INFJ', 'INTJ', 'ISTP', 'ISFP', 'INFP', 'INTP',
          'ESTP', 'ESFP', 'ENFP', 'ENTP', 'ESTJ', 'ESFJ', 'ENFJ', 'ENTJ'
        ]
        && request.resource.data.lastMbtiDate == request.time;
    }

    // No user listing, chat, public profiles, rewards or admin writes yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
