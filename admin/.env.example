# Default development uses local emulators, never the cloud project.
VITE_FIREBASE_TARGET=emulator

# Cloud only: register a Web App in teencu-dev and copy its official config.
# Set VITE_FIREBASE_TARGET=cloud explicitly to use these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=teencu-dev
VITE_FIREBASE_APP_ID=
